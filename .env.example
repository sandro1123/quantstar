# QuantStar 环境变量配置（复制此文件为 .env 后填写）
# cp .env.example .env

# ════════════════════════════════════════════════════════════════
# 必填（prod 启动硬校验 CF-01，缺任一拒载）
# ════════════════════════════════════════════════════════════════
FUYAO_API_KEY=""        # 扶摇金融数据 API 密钥
FEISHU_APP_ID=""        # 飞书应用 ID
FEISHU_APP_SECRET=""    # 飞书应用密钥

# ── 推送与通道配置（全部可选；详见 README《推送与通道配置》）────────
# FEISHU_DM_ID=          # 个人 DM：盘中异动/执行告警
# FEISHU_DM_WEBHOOK=
# FEISHU_GROUP_ID=       # 群：三报+复盘
# FEISHU_GROUP_WEBHOOK=
# FEISHU_HITL_DM_ID=     # HITL 人工确认专用（不配则并入 DM）
# HITL_APPROVER_OPEN_IDS=   # 启用 HITL 审批时必填：允许审批的飞书 open_id/user_id，逗号分隔；未配置则审批一律拒绝
# HITL_ALLOW_ANY_APPROVER=0 # 设为 1 才允许任何能点到卡片的人审批（不建议用于群聊）
# FEISHU_BITABLE_APP_TOKEN=  # ops流水/信号 → 多维表格
# ────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════
# LLM 供应商密钥（可选备链区块）
# 下方供应商按你启用的填；未填的腿自动降级走备链（config/defaults/llm.yaml
# 支持 sensenova/nvidia/openrouter/modelscope 等，主链在 llm.yaml 配置）。
# 卡G1 (2026-09-20): LLM 密钥不再必填 — 开源用户按需选供应商，不锁死。
# ════════════════════════════════════════════════════════════════
MODELSCOPE_API_KEY=""
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
SENSENOVA_KEY1=""       # 商汤 (深层备链, 4-key 轮换)
SENSENOVA_KEY2=""
SENSENOVA_KEY3=""
SENSENOVA_KEY4=""

# 数据源（FUYAO 必填见上；其余可选）
TUSHARE_TOKEN=""
MX_APIKEY=""

# Web API（docker compose 必填；经任何反向代理暴露时也必须设置，至少 16 位随机字符）
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QS_API_TOKEN=""
# QS_CORS_ORIGINS=          # 允许跨域的精确 Origin，逗号分隔；默认不开跨域

# 环境
CONFIG_ENV=dev
